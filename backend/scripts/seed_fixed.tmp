# ============================================================
# HELPERS
# ============================================================

def password_hash(raw_password: str) -> str:
    """
    Deterministic password hash for synthetic seed accounts.
    This is seed-only data.
    """
    return hashlib.sha256(raw_password.encode()).hexdigest()


def create_user(username, email, role):
    return User(
        username=username,
        email=email,
        password_hash=password_hash("EduNexus@123"),
        role=role,
        is_active=True,
    )


def synthetic_student_name(index: int) -> str:
    first = FIRST_NAMES[(index - 1) % len(FIRST_NAMES)]
    last = LAST_NAMES[((index - 1) // len(FIRST_NAMES)) % len(LAST_NAMES)]
    return f"{first} {last}"


def clamp(value, low, high):
    return max(low, min(high, value))


def academic_year(semester):
    mapping = {
        1: "2023-24",
        2: "2023-24",
        3: "2024-25",
        4: "2024-25",
        5: "2025-26",
        6: "2025-26",
        7: "2026-27",
    }
    return mapping[semester]


# ============================================================
# CLEAN EXISTING SEED DATA
# ============================================================

def clear_database(db: Session):
    print("Clearing existing database data...")

    # Delete in dependency-safe order.
    db.query(AuditLog).delete()
    db.query(Notification).delete()
    db.query(Achievement).delete()
    db.query(Resource).delete()
    db.query(AttendanceRecord).delete()
    db.query(AttendanceSession).delete()
    db.query(Mark).delete()
    db.query(Assessment).delete()
    db.query(Enrollment).delete()
    db.query(SemesterResult).delete()
    db.query(Event).delete()
    db.query(Student).delete()
    db.query(Faculty).delete()
    db.query(Subject).delete()
    db.query(Department).delete()
    db.query(User).delete()

    db.commit()


# ============================================================
# DEPARTMENT
# ============================================================

def seed_department(db):
    department = Department(
        code=DEPARTMENT_CODE,
        name=DEPARTMENT_NAME,
    )

    db.add(department)
    db.flush()

    return department


# ============================================================
# FACULTY
# ============================================================

def seed_faculty(db, department):
    faculty_members = []

    for index, (name, employee_id, designation) in enumerate(FACULTY_NAMES, start=1):
        username = employee_id.lower()

        user = create_user(
            username=username,
            email=f"{username}@edunexus.edu",
            role="FACULTY",
        )

        faculty = Faculty(
            user=user,
            employee_id=employee_id,
            name=name,
            department=department,
            designation=designation,
        )

        db.add(faculty)
        faculty_members.append(faculty)

    db.flush()

    return faculty_members


# ============================================================
# SUBJECTS
# ============================================================

def seed_subjects(db, department):
    subjects = {}

    for code, name, semester, credits in SUBJECT_DATA:
        subject = Subject(
            code=code,
            name=name,
            department=department,
            semester=semester,
            credits=credits,
        )

        db.add(subject)
        subjects[code] = subject

    db.flush()

    return subjects


# ============================================================
# STUDENTS
# ============================================================

def seed_students(db, department):
    students = []

    register_numbers = list(
        range(SECTION_A_START, SECTION_A_END + 1)
    ) + list(
        range(SECTION_B_START, SECTION_B_END + 1)
    )

    for index, register_number in enumerate(register_numbers, start=1):

        if register_number <= SECTION_A_END:
            section = "A"
        else:
            section = "B"

        name = synthetic_student_name(index)

        username = f"student{index:03d}"
        email = f"{username}@edunexus.edu"

        user = create_user(
            username=username,
            email=email,
            role="STUDENT",
        )

        # Create meaningful longitudinal student profiles.
        profile_type = index % 10

        if profile_type in (0, 1):
            # High performing
            base_performance = 88
            attendance_base = 92

        elif profile_type in (2, 3):
            # Good / average
            base_performance = 76
            attendance_base = 85

        elif profile_type in (4, 5, 6, 7):
            # Average
            base_performance = 67
            attendance_base = 78

        elif profile_type == 8:
            # At-risk
            base_performance = 48
            attendance_base = 62

        else:
            # Improving student
            base_performance = 58
            attendance_base = 70

        student = Student(
            user=user,
            register_number=str(register_number),
            name=name,
            department=department,
            batch=BATCH,
            semester=7,
            section=section,
            cgpa=None,
        )

        # Store helper values temporarily.
        student._profile_base = base_performance
        student._attendance_base = attendance_base
        student._profile_type = profile_type

        db.add(student)
        students.append(student)

    db.flush()

    return students


# ============================================================
# ENROLLMENTS
# ============================================================

def seed_enrollments(db, students, subjects):
    print("Creating enrollments...")

    for student in students:

        for subject in subjects.values():

            semester = subject.semester

            # Current Sem 7 students are enrolled in Sem 1-7.
            if semester <= 7:

                enrollment = Enrollment(
                    student=student,
                    subject=subject,
                    academic_year=academic_year(semester),
                )

                db.add(enrollment)

    db.flush()


# ============================================================
# HISTORICAL RESULTS
# ============================================================

def seed_semester_results(db, students):
    print("Creating Semester 1-6 results...")

    for student in students:

        base = student._profile_base

        cumulative = []

        for semester in range(1, 7):

            # Natural semester variation.
            variation = random.uniform(-5, 5)

            if student._profile_type == 9:
                # Improving student
                trend = semester * 3
            elif student._profile_type == 8:
                # At-risk student
                trend = -semester * 1.2
            else:
                trend = 0

            sgpa = clamp(
                base + variation + trend,
                45,
                96,
            )

            # Convert marks-like performance to a realistic SGPA range.
            sgpa = round(5.0 + (sgpa - 45) / 10, 2)
            sgpa = clamp(sgpa, 5.0, 9.8)

            cumulative.append(sgpa)

            cgpa = round(sum(cumulative) / len(cumulative), 2)

            # Approximate semester credits from completed academic workload.
            credits = {
                1: 22,
                2: 23,
                3: 22,
                4: 22,
                5: 21,
                6: 22,
            }[semester]

            result = SemesterResult(
                student=student,
                semester=semester,
                sgpa=sgpa,
                cgpa=cgpa,
                total_credits=credits,
                academic_year=academic_year(semester),
            )

            db.add(result)

            if semester == 6:
                student.cgpa = cgpa

    db.flush()


# ============================================================
# HISTORICAL + CURRENT ASSESSMENTS
# ============================================================

def seed_assessments_and_marks(db, students, subjects):
    print("Creating assessments and marks...")

    assessment_objects = []

    # Historical semesters 1-6
    for subject in subjects.values():

        if subject.semester > 6:
            continue

        assessment_specs = [
            ("CAT-I", "CAT", 50),
            ("CAT-II", "CAT", 50),
            ("Model Examination", "MODEL", 100),
        ]

        for name, assessment_type, max_marks in assessment_specs:

            assessment = Assessment(
                subject=subject,
                name=name,
                assessment_type=assessment_type,
                max_marks=max_marks,
                assessment_date=date(
                    2024 + ((subject.semester - 1) // 2),
                    min(12, 2 + subject.semester),
                    min(28, 10 + subject.semester),
                ),
            )

            db.add(assessment)
            assessment_objects.append(assessment)

    # Current Semester 7 assessments
    current_subjects = [
        subject
        for subject in subjects.values()
        if subject.semester == 7
        and subject.code != "NPTEL-MSID"
    ]

    for subject in current_subjects:

        if subject.code == "CB23721":
            specs = [
                ("Project Evaluation I", "PROJECT", 100),
            ]

        else:
            specs = [
                ("CAT-I", "CAT", 50),
                ("Internal Assessment", "INTERNAL", 50),
            ]

        for name, assessment_type, max_marks in specs:

            assessment = Assessment(
                subject=subject,
                name=name,
                assessment_type=assessment_type,
                max_marks=max_marks,
                assessment_date=date(2026, 9, 10),
            )

            db.add(assessment)
            assessment_objects.append(assessment)

    db.flush()

    # Generate marks.
    for assessment in assessment_objects:

        subject = assessment.subject

        for student in students:

            # NPTEL does not receive fabricated marks.
            if subject.code == "NPTEL-MSID":
                continue

            base = student._profile_base

            # Current students have more variation.
            variation = random.uniform(-12, 12)

            if student._profile_type == 9:
                trend = 8
            elif student._profile_type == 8:
                trend = -5
            else:
                trend = 0

            percentage = clamp(
                base + variation + trend,
                25,
                98,
            )

            marks = round(
                assessment.max_marks * percentage / 100,
                1,
            )

            db.add(
                Mark(
                    student=student,
                    assessment=assessment,
                    marks_obtained=marks,
                )
            )

    db.flush()


# ============================================================
# ATTENDANCE
# ============================================================

def seed_attendance(db, students, subjects, faculty_members):
    print("Creating attendance sessions and records...")

    current_subjects = [
        subject
        for subject in subjects.values()
        if subject.semester == 7
        and subject.code != "NPTEL-MSID"
    ]

    start_date = date(2026, 8, 3)

    for subject_index, subject in enumerate(current_subjects):

        faculty = faculty_members[
            subject_index % len(faculty_members)
        ]

        # 8 sessions per subject.
        for session_index in range(8):

            session_date = start_date + timedelta(
                days=session_index * 7 + subject_index
            )

            # Keep all generated dates <= current date.
            if session_date > date.today():
                continue

            period = (session_index % 5) + 1

            for section in ["A", "B"]:

                session = AttendanceSession(
                    subject=subject,
                    faculty=faculty,
                    session_date=session_date,
                    period=period,
                    semester=7,
                    section=section,
                )

                db.add(session)
                db.flush()

                section_students = [
                    student
                    for student in students
                    if student.section == section
                ]

                for student in section_students:

                    attendance_probability = (
                        student._attendance_base / 100
                    )

                    status = (
                        "PRESENT"
                        if random.random() < attendance_probability
                        else "ABSENT"
                    )

                    db.add(
                        AttendanceRecord(
                            session=session,
                            student=student,
                            status=status,
                        )
                    )

    db.flush()


# ============================================================
# RESOURCES
# ============================================================

def seed_resources(db, subjects, faculty_members):
    print("Creating academic resources...")

    resource_specs = [
        ("CB23E36", "Cryptology Fundamentals", "PDF"),
        ("CB23731", "Data Visualization Notes", "PDF"),
        ("CB23732", "IT Project Management Guide", "PDF"),
        ("CB23721", "Project Evaluation Guidelines", "PDF"),
        ("CS23611", "Cloud Computing Unit Notes", "PDF"),
        ("CS23612", "Big Data Analytics Notes", "PDF"),
        ("CS23613", "Deep Learning Study Material", "PDF"),
    ]

    for index, (subject_code, title, resource_type) in enumerate(resource_specs):

        if subject_code not in subjects:
            continue

        subject = subjects[subject_code]
        faculty = faculty_members[index % len(faculty_members)]

        resource = Resource(
            subject=subject,
            faculty=faculty,
            title=title,
            description=f"Seed academic resource for {subject.name}.",
            file_name=f"{subject_code.lower()}_notes.pdf",
            file_path=f"resources/{subject_code.lower()}_notes.pdf",
            resource_type=resource_type,
        )

        db.add(resource)

    db.flush()


# ============================================================
# ACHIEVEMENTS
# ============================================================

def seed_achievements(db, students):
    print("Creating student achievements...")

    achievement_templates = [
        (
            "Hackathon Participation",
            "HACKATHON",
            "Participated in an inter-college technology hackathon.",
        ),
        (
            "Python Workshop",
            "WORKSHOP",
            "Completed a technical workshop on Python and data science.",
        ),
        (
            "Technical Symposium",
            "COMPETITION",
            "Participated in a technical symposium event.",
        ),
        (
            "Student Club Leadership",
            "LEADERSHIP",
            "Contributed to student club activities and event coordination.",
        ),
        (
            "Internship Experience",
            "INTERNSHIP",
            "Completed an industry internship.",
        ),
    ]

    for index, student in enumerate(students):

        # Give roughly one achievement to every third student.
        if index % 3 != 0:
            continue

        title, category, description = achievement_templates[
            (index // 3) % len(achievement_templates)
        ]

        status = "VERIFIED" if index % 2 == 0 else "PENDING"

        db.add(
            Achievement(
                student=student,
                title=title,
                category=category,
                description=description,
                verification_status=status,
            )
        )

    db.flush()


