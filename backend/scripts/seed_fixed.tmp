    db.flush()


# ============================================================
# NOTIFICATIONS
# ============================================================

def seed_notifications(db, students):
    print("Creating notifications...")

    for student in students:

        # Only create a small number of notifications.
        if int(student.register_number[-2:]) % 5 != 0:
            continue

        db.add(
            Notification(
                user_id=student.user_id,
                title="Attendance Reminder",
                message=(
                    "Review your current semester attendance "
                    "and maintain the required attendance percentage."
                ),
                is_read=False,
            )
        )

    db.flush()


# ============================================================
# AUDIT LOG
# ============================================================

def seed_audit_logs(db, faculty_members):
    print("Creating audit records...")

    for faculty in faculty_members:

        db.add(
            AuditLog(
                user_id=faculty.user_id,
                action="SEED_INITIALIZATION",
                entity_type="SYSTEM",
                entity_id=None,
                details="Synthetic EduNexus development dataset initialized.",
            )
        )

    db.flush()


# ============================================================
# MAIN
# ============================================================

def main():

    print("=" * 60)
    print("EDUNEXUS DATABASE SEED")
    print("=" * 60)

    try:

        clear_database(DB)

        department = seed_department(DB)

        faculty_members = seed_faculty(
            DB,
            department,
        )

        subjects = seed_subjects(
            DB,
            department,
        )

        students = seed_students(
            DB,
            department,
        )

        seed_enrollments(
            DB,
            students,
            subjects,
        )

        seed_semester_results(
            DB,
            students,
        )

        seed_assessments_and_marks(
            DB,
            students,
            subjects,
        )

        seed_attendance(
            DB,
            students,
            subjects,
            faculty_members,
        )

        seed_resources(
            DB,
            subjects,
            faculty_members,
        )

        seed_achievements(
            DB,
            students,
        )

        seed_events(DB)

        seed_notifications(
            DB,
            students,
        )

        seed_audit_logs(
            DB,
            faculty_members,
        )

        DB.commit()

        print()
        print("=" * 60)
        print("SEED COMPLETED SUCCESSFULLY")
        print("=" * 60)
        print(f"Students       : {DB.query(Student).count()}")
        print(f"Faculty        : {DB.query(Faculty).count()}")
        print(f"Subjects       : {DB.query(Subject).count()}")
        print(f"Enrollments    : {DB.query(Enrollment).count()}")
        print(f"Assessments    : {DB.query(Assessment).count()}")
        print(f"Marks          : {DB.query(Mark).count()}")
        print(f"Attendance     : {DB.query(AttendanceRecord).count()}")
        print(f"Results        : {DB.query(SemesterResult).count()}")
        print(f"Resources      : {DB.query(Resource).count()}")
        print(f"Achievements   : {DB.query(Achievement).count()}")
        print(f"Events         : {DB.query(Event).count()}")
        print("=" * 60)

    except Exception as exc:

        DB.rollback()

        print()
        print("=" * 60)
        print("SEED FAILED")
        print("=" * 60)
        print(type(exc).__name__)
        print(str(exc))
        print("=" * 60)

        raise

    finally:
        DB.close()


if __name__ == "__main__":
    main()
